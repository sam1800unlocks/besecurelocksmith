---
import BaseLayout from '../layouts/BaseLayout.astro';
import PromoBar from './sections/PromoBar.astro';
import NavBar from './sections/NavBar.astro';
import Footer from './sections/Footer.astro';
import Container from './primitives/Container.astro';
import Button from './primitives/Button.astro';
import TrustStrip from './sections/TrustStrip.astro';
import CtaCard from './sections/CtaCard.astro';
import { site, telHref } from '../config/site';
import { resolveLocation, resolvePhone } from '../lib/locations';
import { productBySlug } from '../data/products.ts';

const { product } = Astro.props;
const location = 'main';
const phone = resolvePhone(resolveLocation(location));
const pageUrl = `https://besecurelocksmith.com/products/${product.slug}/`;
const related = (product.related || []).map((s) => productBySlug[s]).filter(Boolean);

// Geo-target the <title> for Gainesville & Ocala, FL — inject the location ahead
// of the brand so every product page carries the local signal. Titles end in two
// brand forms ("| Be Secure Locksmith" and "| Be Secure"); handle both.
const GEO = ' in Gainesville & Ocala, FL';
const geoTitle = product.title.includes(' | Be Secure Locksmith')
  ? product.title.replace(' | Be Secure Locksmith', `${GEO} | Be Secure Locksmith`)
  : product.title.includes(' | Be Secure')
    ? product.title.replace(' | Be Secure', `${GEO} | Be Secure`)
    : `${product.title}${GEO} | Be Secure Locksmith`;

const GVILLE = '/service-areas/locksmith-gainesville-fl/';
const OCALA = '/service-areas/locksmith-ocala-fl/';

const ctaBody = `Have questions about ${product.name.toLowerCase()} — or ready to upgrade? Be Secure Locksmith serves Gainesville, Ocala, and all of North Central FL. <a href="/contact-us/">Contact us today</a> for a free, no-obligation quote.`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://besecurelocksmith.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://besecurelocksmith.com/products/' },
    { '@type': 'ListItem', position: 3, name: product.name, item: pageUrl },
  ],
};
const articleJsonLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: product.h1,
  description: product.description,
  about: product.name,
  author: { '@type': 'Organization', name: site.name, url: 'https://besecurelocksmith.com/' },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: pageUrl,
};
const faqJsonLd = product.faqs?.length ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: product.faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
} : null;

const checkSvg = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#31a24c" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
const minusSvg = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#b23b3b" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>';
---
<BaseLayout title={geoTitle} description={product.description} location={location} ogType="article" robots="follow, index, max-image-preview:large">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  </Fragment>

  <PromoBar location={location} />
  <NavBar location={location} />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden text-white" style="background:linear-gradient(160deg,#0e4a8f 0%,#0b2f5e 42%,#0a1830 100%);">
      <div class="absolute inset-0 opacity-[0.09]" style="background-image:radial-gradient(circle at 1px 1px,#ffffff 1px,transparent 0);background-size:22px 22px;"></div>
      <div class="absolute -top-28 -right-20 w-[540px] h-[540px] rounded-full pointer-events-none" style="background:radial-gradient(circle,rgba(56,150,255,0.60),transparent 70%);"></div>
      <Container>
        <div class="relative max-w-[1180px] mx-auto py-14 md:py-20">
          <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-2 text-[13px] text-white/70">
            <a href="/" class="hover:text-white">Home</a><span aria-hidden="true">/</span>
            <a href="/products/" class="hover:text-white">Products</a><span aria-hidden="true">/</span>
            <span class="text-white">{product.name}</span>
          </nav>
          <span class="inline-flex items-center rounded-pill bg-white/10 text-white/90 text-[12px] font-bold uppercase tracking-[0.6px] px-[12px] py-[6px] mb-4">{product.category} Product Guide</span>
          <h1 class="m-0 mb-3 font-medium text-white max-w-[820px]" style="font-size:clamp(30px,5vw,50px);line-height:1.1;letter-spacing:-1.1px;">{product.h1}</h1>
          <p class="m-0 mb-4 text-[13px] font-bold uppercase tracking-[0.7px] text-white/60">Gainesville &middot; Ocala &middot; North Central Florida</p>
          <p class="m-0 mb-7 text-[18px] leading-[1.45] text-white/80 max-w-[720px]">{product.intro}</p>
          <div class="flex flex-wrap gap-3">
            <Button href={telHref(phone)} variant="call">{phone}</Button>
            <Button href={product.service.href} variant="booking">{product.service.label}</Button>
          </div>
        </div>
      </Container>
    </section>

    <TrustStrip />

    <article class="article-body">
      <Container>
        <div class="max-w-[820px] mx-auto py-12 md:py-16">
          <!-- WHAT IT IS -->
          <h2 class="m-0 text-ink font-medium tracking-[-0.6px]" style="font-size:clamp(26px,3.4vw,34px);line-height:1.2;">{product.what.heading}</h2>
          <div class="mt-3 mb-5 h-1 w-12 rounded-full bg-primary"></div>
          <div class="text-[16px] leading-[1.65] text-secondary [&_p]:mb-4 [&_strong]:text-ink" set:html={product.what.html}></div>

          <!-- TYPES -->
          <h2 class="mt-12 m-0 text-ink font-medium tracking-[-0.6px]" style="font-size:clamp(24px,3.2vw,30px);line-height:1.2;">{product.types.heading}</h2>
          <div class="mt-3 mb-5 h-1 w-12 rounded-full bg-primary"></div>
          <div class="grid gap-3">
            {product.types.items.map((t) => (
              <div class="rounded-[14px] border border-border bg-white p-5">
                <p class="m-0 mb-1 text-ink font-bold text-[16px]">{t.name}</p>
                <p class="m-0 text-[15px] leading-[1.55] text-secondary">{t.desc}</p>
              </div>
            ))}
          </div>

          <!-- PROS & CONS -->
          <h2 class="mt-12 m-0 text-ink font-medium tracking-[-0.6px]" style="font-size:clamp(24px,3.2vw,30px);line-height:1.2;">Pros &amp; cons</h2>
          <div class="mt-3 mb-5 h-1 w-12 rounded-full bg-primary"></div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-[16px] border border-border bg-surface p-6">
              <p class="m-0 mb-4 text-ink font-bold text-[15px] uppercase tracking-[0.6px]">Pros</p>
              <ul class="m-0 p-0 list-none flex flex-col gap-3">
                {product.pros.map((it) => (
                  <li class="flex items-start gap-3 text-[15px] leading-[1.5] text-body">
                    <span class="mt-[3px] shrink-0 w-5 h-5 rounded-full bg-success-bg flex items-center justify-center" set:html={checkSvg}></span>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="rounded-[16px] border border-border bg-surface p-6">
              <p class="m-0 mb-4 text-ink font-bold text-[15px] uppercase tracking-[0.6px]">Keep in mind</p>
              <ul class="m-0 p-0 list-none flex flex-col gap-3">
                {product.cons.map((it) => (
                  <li class="flex items-start gap-3 text-[15px] leading-[1.5] text-body">
                    <span class="mt-[3px] shrink-0 w-5 h-5 rounded-full flex items-center justify-center" style="background:#fdecec;" set:html={minusSvg}></span>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- COMPARISON -->
          <h2 class="mt-12 m-0 text-ink font-medium tracking-[-0.6px]" style="font-size:clamp(24px,3.2vw,30px);line-height:1.2;">{product.comparison.heading}</h2>
          <div class="mt-3 mb-5 h-1 w-12 rounded-full bg-primary"></div>
          <div class="text-[16px] leading-[1.65] text-secondary [&_p]:mb-4 [&_strong]:text-ink [&_em]:italic" set:html={product.comparison.html}></div>

          <!-- USE CASES -->
          <h2 class="mt-12 m-0 text-ink font-medium tracking-[-0.6px]" style="font-size:clamp(24px,3.2vw,30px);line-height:1.2;">{product.useCases.heading}</h2>
          <div class="mt-3 mb-5 h-1 w-12 rounded-full bg-primary"></div>
          <ul class="my-2 p-0 list-none flex flex-col gap-2">
            {product.useCases.items.map((it) => (
              <li class="relative pl-6 text-[16px] leading-[1.6] text-secondary">
                <span class="absolute left-0 top-[10px] w-2 h-2 rounded-full bg-primary"></span>
                <span>{it}</span>
              </li>
            ))}
          </ul>

          <!-- LOCAL / SERVICE (hub-and-spoke support for the money pages) -->
          <section class="mt-12 rounded-[24px] border border-border p-7 md:p-9" style="background:#eef4ff;">
            <h2 class="m-0 text-ink font-medium tracking-[-0.4px]" style="font-size:clamp(22px,3vw,28px);line-height:1.2;">{product.name} service in Gainesville &amp; Ocala, FL</h2>
            <div class="mt-3 mb-4 h-1 w-12 rounded-full bg-primary"></div>
            <p class="m-0 mb-4 text-[16px] leading-[1.65] text-secondary">
              Reading up is one thing — getting it installed right is another. Be Secure Locksmith’s licensed, mobile technicians handle <a href={product.service.href} class="text-primary font-semibold">{product.service.label.toLowerCase()}</a> for homes and businesses across <a href={GVILLE} class="text-primary font-semibold">Gainesville</a>, <a href={OCALA} class="text-primary font-semibold">Ocala</a>, and the surrounding North Central Florida communities. Not sure we reach you? <a href="/service-areas/" class="text-primary font-semibold">See all service areas</a>.
            </p>
            <div class="flex flex-wrap gap-3">
              <Button href={telHref(phone)} variant="call">{phone}</Button>
              <Button href={product.service.href} variant="dark">{product.service.label}</Button>
            </div>
          </section>

          <!-- RELATED PRODUCTS -->
          {related.length > 0 && (
            <section class="mt-12">
              <h2 class="m-0 text-ink font-medium tracking-[-0.5px]" style="font-size:clamp(22px,3vw,28px);">Related product guides</h2>
              <div class="mt-3 mb-5 h-1 w-12 rounded-full bg-primary"></div>
              <div class="grid gap-3 sm:grid-cols-2">
                {related.map((r) => (
                  <a href={`/products/${r.slug}/`} class="group flex items-center justify-between gap-3 rounded-[14px] border border-border bg-white p-5 transition-colors hover:border-primary">
                    <span class="text-[16px] font-bold text-ink group-hover:text-primary">{r.name}</span>
                    <span class="text-primary font-bold" aria-hidden="true">&rarr;</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- FAQ -->
          {product.faqs?.length > 0 && (
            <section class="mt-14">
              <h2 class="m-0 text-ink font-medium tracking-[-0.4px]" style="font-size:clamp(22px,3vw,28px);line-height:1.2;">Frequently asked questions</h2>
              <div class="mt-3 mb-6 h-1 w-12 rounded-full bg-primary"></div>
              <div class="flex flex-col gap-3">
                {product.faqs.map((faq, i) => (
                  <details data-faq open={i === 0 ? true : undefined} class="border border-border border-l-4 border-l-primary rounded-2xl overflow-hidden bg-white">
                    <summary class="flex items-center justify-between gap-4 px-6 py-[22px] cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                      <span class="text-[18px] font-bold leading-snug text-ink" style="letter-spacing:-0.2px;">{faq.question}</span>
                      <span class="shrink-0 transition-transform duration-200 [[open]_&]:rotate-180">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5d6c7b" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
                      </span>
                    </summary>
                    <div class="px-6 pb-6 text-[16px] leading-relaxed text-muted" style="letter-spacing:-0.16px;">{faq.answer}</div>
                  </details>
                ))}
              </div>
            </section>
          )}

          <!-- CTA -->
          <div class="mt-14"><CtaCard location={location} heading={`Ready to talk ${product.name.toLowerCase()}?`} body={ctaBody} /></div>
        </div>
      </Container>
    </article>
  </main>

  <Footer location={location} />
  <script>
    import './scripts/faq.ts';
  </script>
</BaseLayout>
