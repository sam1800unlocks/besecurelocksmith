---
// Top-of-page strip: each office's address, phone and hours, so visitors (and the
// map listings' "website" check) see the same NAP + hours the schema declares.
// Location pages show only their own office; every other page shows both.
import { offices, type Office } from '../../config/offices';
import { telHref } from '../../config/site';

const { location = 'main' } = Astro.props;
const list: Office[] =
  location === 'gainesville' ? [offices.gainesville]
  : location === 'ocala' ? [offices.ocala]
  : [offices.gainesville, offices.ocala];

const mapsHref = (o: Office) => `https://maps.google.com/?cid=${o.cid}`;
// "Wheelchair accessible entrance, parking lot, restroom & seating"
const accessLine = (o: Office) => {
  const parts = o.accessibility.map((a) => a.replace(/^Wheelchair accessible /, ''));
  const list = parts.length > 1 ? `${parts.slice(0, -1).join(', ')} & ${parts.at(-1)}` : parts[0];
  return `Wheelchair accessible ${list}`;
};
const cols =list.length === 2 ? 'md:grid-cols-2 md:divide-x md:divide-white/25' : '';
---
<div aria-label="Office locations and hours" role="region" class="w-full bg-booking text-white text-[13px] leading-[1.45]">
  <div class={`max-w-[960px] mx-auto px-4 grid ${cols} divide-y divide-white/20 md:divide-y-0`}>
    {list.map((o) => (
      <div class="flex flex-col items-center text-center gap-1.5 py-3.5 md:px-8">
        <p class="m-0 flex items-center gap-1.5 text-[12px] font-extrabold uppercase tracking-[0.8px]">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="text-amber" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {o.label} Office
        </p>
        <a href={mapsHref(o)} target="_blank" rel="noopener noreferrer" class="text-white hover:underline underline-offset-2">{o.street}, {o.cityStateZip}</a>
        <a href={telHref(o.phone)} class="inline-flex items-center gap-1.5 rounded-pill bg-white text-booking hover:bg-surface transition-colors font-bold text-[13px] px-3.5 py-1">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {o.phone}
        </a>
        <p class="m-0 flex items-center gap-1.5">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="text-amber" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {o.hoursDisplay}
        </p>
        {o.accessibility.length > 0 && (
          <p class="m-0 flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-amber" aria-hidden="true"><circle cx="16" cy="4" r="1"/><path d="m18 19 1-7-6 1"/><path d="m5 8 3-3 5.5 3-2.36 3.5"/><path d="M4.24 14.5a5 5 0 0 0 6.88 6"/><path d="M13.76 17.5a5 5 0 0 0-6.88-6"/></svg>
            {accessLine(o)}
          </p>
        )}
      </div>
    ))}
  </div>
</div>
