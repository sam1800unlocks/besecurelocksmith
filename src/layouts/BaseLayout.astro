---
import '../styles/tokens.css';
// Self-hosted font (same-origin, no render-blocking Google Fonts request).
import '@fontsource-variable/figtree';
// Preload the primary (latin) subset so it's fetched immediately, minimizing FOUT.
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2';
import { resolveLocation, resolvePhone } from '../lib/locations';
import { site } from '../config/site';
import { adsConversionId, adsTagPaths } from '../config/tracking';
import { organizationNode } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  location?: string;
  ogType?: string;
  ogImage?: string;
  robots?: string;
  schema?: 'org-home' | 'org-lean' | 'none';
}

const {
  title,
  description = '',
  location = 'main',
  ogType = 'website',
  ogImage = '/img/og-default.jpg',
  robots,
  schema = 'none',
} = Astro.props;
const loc = resolveLocation(location);
const phone = resolvePhone(loc);

const siteBase = Astro.site?.href ?? 'https://besecurelocksmith.com/';
const path = Astro.url?.pathname ?? '/';
const canonical = new URL(path, siteBase).href;
const ogImageUrl = ogImage ? new URL(ogImage, siteBase).href : undefined;
// Only advertise 1200x630 for our known default OG image; page-supplied
// images may differ in size, so we omit width/height for those.
const ogIsDefault = ogImage === '/img/og-default.jpg';

// Google Ads base tag runs only on the paths listed in the tracking config.
const adsPath = path.endsWith('/') ? path : `${path}/`;
const showAdsTag = adsTagPaths.includes(adsPath);

const orgSchema = schema === 'org-home' ? organizationNode({ homepage: true })
  : schema === 'org-lean' ? organizationNode({ homepage: false })
  : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  {/* Google Analytics (GA4) — production builds only, so local `astro dev` stays out of the data. */}
  {import.meta.env.PROD && (
    <Fragment>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CJ59FQS2T4"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-CJ59FQS2T4');
      </script>
      {/* Google Ads base tag — only on the pages in src/config/tracking.ts. */}
      {showAdsTag && <script is:inline set:html={`gtag('config', ${JSON.stringify(adsConversionId)});`} />}
    </Fragment>
  )}

  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {robots && <meta name="robots" content={robots} />}
  <link rel="canonical" href={canonical} />

  <!-- Preload the primary font subset to cut FOUT / font-swap shift -->
  <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin="anonymous" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <!-- Open Graph / Twitter -->
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  {ogImageUrl && ogIsDefault && <meta property="og:image:width" content="1200" />}
  {ogImageUrl && ogIsDefault && <meta property="og:image:height" content="630" />}
  {ogImageUrl && <meta property="og:image:alt" content={title} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

  {orgSchema &&<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />}
  <slot name="head" />
</head>
<body>
  {/* Skip link: first thing a keyboard user tabs to; hidden until focused. */}
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:rounded-pill focus:bg-ink focus:px-5 focus:py-3 focus:text-[15px] focus:font-bold focus:text-white">Skip to main content</a>
  <slot />
  {/* "Talk to Ava" voice assistant — the client's own script, from the same
      receptionist server that runs their phone system. It mounts a floating
      button in a shadow root; mic audio, the AI and lead capture all run on
      their server. The consent line ("transcribed and saved") and its privacy
      link live inside the script, so they change it there, not here.
      is:inline keeps it a plain tag instead of bundling it into our JS. */}
  <script is:inline defer src="https://be-secure-receptionist.fly.dev/widget.js"></script>
</body>
</html>
