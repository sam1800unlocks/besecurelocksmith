---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PromoBar from '../../../components/sections/PromoBar.astro';
import NavBar from '../../../components/sections/NavBar.astro';
import AreaHero from '../../../components/sections/AreaHero.astro';
import TrustStrip from '../../../components/sections/TrustStrip.astro';
import LocalIntro from '../../../components/sections/LocalIntro.astro';
import ServicesGrid from '../../../components/sections/ServicesGrid.astro';
import AsSeenIn from '../../../components/sections/AsSeenIn.astro';
import RelatedBlogs from '../../../components/sections/RelatedBlogs.astro';
import AreaMap from '../../../components/sections/AreaMap.astro';
import AreaNeighborhoods from '../../../components/sections/AreaNeighborhoods.astro';
import Faq from '../../../components/sections/Faq.astro';
import CtaCard from '../../../components/sections/CtaCard.astro';
import Footer from '../../../components/sections/Footer.astro';
import Container from '../../../components/primitives/Container.astro';
import { resolveLocation, resolvePhone } from '../../../lib/locations';
import { offices } from '../../../config/offices';
import { buildAreaFaqs } from '../../../lib/area-faqs';
import { officeBySlug, locationNode } from '../../../lib/schema';

export async function getStaticPaths() {
  // Geographic neighbors for internal interlinking. Each non-hub city includes its
  // hub (Gainesville or Ocala) so link equity funnels toward the two priority pages.
  // Defined inside getStaticPaths — Astro runs it in an isolated scope.
  const AREA_NEIGHBORS = {
    'locksmith-gainesville-fl': ['locksmith-alachua-fl', 'locksmith-high-springs-fl', 'locksmith-newberry-fl', 'locksmith-williston-fl'],
    'locksmith-ocala-fl': ['locksmith-belleview-fl', 'locksmith-silver-springs-fl', 'locksmith-marion-oaks-ocala-fl', 'locksmith-the-villages-fl'],
    'locksmith-alachua-fl': ['locksmith-gainesville-fl', 'locksmith-high-springs-fl', 'locksmith-newberry-fl'],
    'locksmith-belleview-fl': ['locksmith-ocala-fl', 'locksmith-silver-springs-fl', 'locksmith-the-villages-fl'],
    'locksmith-hampton-fl': ['locksmith-gainesville-fl', 'locksmith-lake-city-fl', 'locksmith-williston-fl'],
    'locksmith-high-springs-fl': ['locksmith-gainesville-fl', 'locksmith-alachua-fl', 'locksmith-newberry-fl'],
    'locksmith-lake-city-fl': ['locksmith-gainesville-fl', 'locksmith-high-springs-fl', 'locksmith-hampton-fl'],
    'locksmith-marion-oaks-ocala-fl': ['locksmith-ocala-fl', 'locksmith-belleview-fl', 'locksmith-the-villages-fl'],
    'locksmith-newberry-fl': ['locksmith-gainesville-fl', 'locksmith-alachua-fl', 'locksmith-williston-fl'],
    'locksmith-silver-springs-fl': ['locksmith-ocala-fl', 'locksmith-belleview-fl', 'locksmith-silver-springs-shores-ocala-fl'],
    'locksmith-silver-springs-shores-ocala-fl': ['locksmith-ocala-fl', 'locksmith-silver-springs-fl', 'locksmith-belleview-fl'],
    'locksmith-the-villages-fl': ['locksmith-ocala-fl', 'locksmith-belleview-fl', 'locksmith-marion-oaks-ocala-fl'],
    'locksmith-williston-fl': ['locksmith-gainesville-fl', 'locksmith-newberry-fl', 'locksmith-ocala-fl'],
  };
  const areas = await getCollection('service-areas');
  const cityBySlug = Object.fromEntries(areas.map((a) => [a.data.slug, a.data.city]));
  return areas.map((a) => {
    const neighbors = (AREA_NEIGHBORS[a.data.slug] || [])
      .filter((s) => cityBySlug[s])
      .map((s) => ({ href: `/service-areas/${s}/`, label: `${cityBySlug[s]} locksmith` }));
    return { params: { slug: a.data.slug }, props: { area: a.data, neighbors } };
  });
}

const { area, neighbors } = Astro.props;

// Location-specific "As featured in" press mentions (rendered like the homepage row).
const AREA_PRESS = {
  'locksmith-ocala-fl': [
    { name: 'Markets Insider', file: 'markets-insider.png', href: 'https://markets.businessinsider.com/news/stocks/be-secure-locksmith-warns-ocala-and-marion-county-residents-how-to-spot-a-locksmith-scam-and-what-a-real-local-locksmith-looks-like-1036369094' },
    { name: 'Yahoo! Finance', file: 'yahoo-finance.png', href: 'https://finance.yahoo.com/small-business/articles/secure-locksmith-warns-ocala-marion-213100373.html' },
    { name: 'Associated Press', file: 'associated-press.png', href: 'https://apnews.com/press-release/globenewswire-mobile/press-release-9d2ad4ad42e7cdd42dd7bd32cfc44cb4' },
    { name: 'Benzinga', file: 'benzinga.png', href: 'https://www.benzinga.com/pressreleases/26/07/g60713340/be-secure-locksmith-warns-ocala-and-marion-county-residents-how-spot-locksmith-scam-and-what-real-lo' },
  ],
};
const press = AREA_PRESS[area.slug] ?? null;
const loc = resolveLocation(area.location);
const phone = resolvePhone(loc);
const office = officeBySlug(area.slug);        // Office | undefined
const locNode = office ? locationNode(office.key) : null;
const servingOffice = offices[area.office ?? 'gainesville'];
const areaFaqs = (area.faqs && area.faqs.length)
  ? area.faqs.map((q, i) => ({ ...q, order: i + 1 }))
  : buildAreaFaqs(area, servingOffice.label);
const pageUrl = `https://besecurelocksmith.com/service-areas/${area.slug}/`;
const ctaBody = `Locked out or need new locks in ${area.city}? Be Secure Locksmith is your trusted local, mobile locksmith. <a href="/contact-us/">Contact us today</a> or call now — fast, licensed, and insured service.`;
const pageTitle = office ? `Locksmith in ${office.label}, FL | Be Secure Locksmith` : area.title;
const pageDesc = office
  ? `Be Secure Locksmith's ${office.label}, FL office — mobile locksmith for car, home & business. Lockouts, rekeys, car keys & installs. Call ${office.phone}.`
  : area.description;
const breadcrumbJsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://besecurelocksmith.com/' },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://besecurelocksmith.com/service-areas/' },
    { '@type': 'ListItem', position: 3, name: area.city, item: pageUrl },
  ],
};
---
<BaseLayout title={pageTitle} description={pageDesc} location={area.location} schema={office ? 'org-lean' : 'none'}>
  <Fragment slot="head">
    {locNode && <script type="application/ld+json" set:html={JSON.stringify(locNode)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <PromoBar location={area.location} />
  <NavBar location={area.location} />
  <main>
    <AreaHero city={area.city} heroSubhead={area.heroSubhead} location={area.location} />
    <TrustStrip />
    {press && <AsSeenIn logos={press} />}
    <LocalIntro city={area.city} intro={area.intro} />
    {office && (
      <section class="border-b border-border" style="background:#f4f4f4;">
        <Container>
          <div class="max-w-[1180px] mx-auto py-8 flex flex-wrap items-center gap-x-10 gap-y-3">
            <div>
              <p class="m-0 text-[12px] font-bold uppercase tracking-[1px] text-muted">Our {office.label} Office</p>
              <p class="m-0 mt-1 text-[15px] font-semibold text-ink">{office.street}<br />{office.cityStateZip}</p>
            </div>
            <a href={`https://www.google.com/maps/place/?cid=${office.cid}`} target="_blank" rel="noopener noreferrer" class="text-[14px] font-semibold text-primary hover:text-primary-hover">View on Google Maps &rarr;</a>
            <a href={`tel:${office.trackingPhone.replace(/[^0-9+]/g,'')}`} class="inline-flex items-center rounded-pill bg-call hover:bg-call-hover text-white font-bold text-[14px] px-[18px] py-[9px]">{office.phone}</a>
          </div>
        </Container>
      </section>
    )}
    <AreaMap area={area} cid={office?.cid} />
    <ServicesGrid />
    <RelatedBlogs posts={area.relatedBlogs} city={area.city} />
    <AreaNeighborhoods city={area.city} neighborhoods={area.neighborhoods} />
    {neighbors.length > 0 && (
      <section>
        <Container>
          <div class="max-w-[1180px] mx-auto py-10 border-t border-border">
            <h2 class="m-0 mb-2 text-ink font-medium tracking-[-0.5px]" style="font-size:clamp(22px,3vw,28px);">Locksmith Services in Nearby Areas</h2>
            <div class="mt-3 mb-5 h-1 w-12 rounded-full bg-primary"></div>
            <p class="m-0 mb-5 text-[16px] leading-[1.6] text-secondary max-w-[720px]">Be Secure Locksmith is fully mobile, so we also help homes and businesses in the communities around {area.city}:</p>
            <div class="flex flex-wrap gap-2.5">
              {neighbors.map((n) => (
                <a href={n.href} class="inline-flex items-center rounded-full border border-border bg-white px-4 py-2 text-[14px] font-semibold text-ink transition-colors hover:border-primary hover:text-primary">{n.label} &rarr;</a>
              ))}
            </div>
          </div>
        </Container>
      </section>
    )}
    <Faq faqs={areaFaqs} variant="rich" />
    <section>
      <Container>
        <div class="max-w-[1180px] mx-auto pb-16 md:pb-20">
          <CtaCard location={area.location} heading={`Contact Be Secure Locksmith in ${area.city}, FL`} body={ctaBody} />
        </div>
      </Container>
    </section>
  </main>
  <Footer location={area.location} />
</BaseLayout>
